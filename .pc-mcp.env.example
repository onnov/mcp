# Source/export these variables in your terminal; never commit real credentials.
# OpenAI Tunnel mode (default). For reverse SSH use .pc-mcp.ssh.env.example.
PC_MCP_TRANSPORT='tunnel'
PC_MCP_ROOT='/home/YOUR_LOGIN/projects'
PC_MCP_STATE='/home/YOUR_LOGIN/.config/pc-mcp'
CONTROL_PLANE_TUNNEL_ID='tunnel_REPLACE_WITH_REAL_ID'
CONTROL_PLANE_API_KEY='REPLACE_WITH_RUNTIME_API_KEY'
# Optional: all tunnel traffic and target DNS through SOCKS5, no direct fallback.
# Unset/empty preserves normal system/environment networking. Numeric proxy IP.
# PC_MCP_SOCKS5_PROXY='socks5h://127.0.0.1:1084'
# Optional, when a specific Platform organization must be selected:
# CONTROL_PLANE_ORGANIZATION_ID='org_...'
# Optional, ONLY for explicitly confirmed git/gh jobs, never ordinary builds/tests:
# PC_MCP_GH_TOKEN='github_pat_...'
