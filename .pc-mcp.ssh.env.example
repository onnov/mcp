# Copy to $HOME/.config/pc-mcp/server.env (chmod 600), OUTSIDE PC_MCP_ROOT.
# Load with: set -a; source .pc-mcp.env; set +a
# Replace the example addresses/paths. Never commit real secrets.
PC_MCP_TRANSPORT='ssh'
PC_MCP_ROOT='/home/YOUR_LOGIN/projects'
PC_MCP_PUBLIC_URL='https://pc-mcp.example.com'

PC_MCP_SSH_ADDR='your-server.example.com:22'
PC_MCP_SSH_USER='YOUR_SSH_LOGIN'
PC_MCP_SSH_KEY_FILE='/home/YOUR_LOGIN/.ssh/pc_mcp_ed25519'
PC_MCP_SSH_KNOWN_HOSTS='/home/YOUR_LOGIN/.ssh/known_hosts'
# Optional, for an encrypted key:
# PC_MCP_SSH_KEY_PASSPHRASE='...'

# Generate: ./pc-mcp --hash-password
PC_MCP_OWNER_PASSWORD_HASH=''
# Generate: openssl rand -hex 32
PC_MCP_OAUTH_CLIENT_SECRET=''

# Defaults; change only when necessary:
# PC_MCP_HTTP_ADDR='127.0.0.1:8182'
# PC_MCP_SSH_REMOTE_ADDR='127.0.0.1:18182'
# PC_MCP_OAUTH_CLIENT_ID='pc-mcp-chatgpt'
# Copy the exact callback from the ChatGPT plugin form if different.
# Claude callbacks (claude.ai/claude.com /api/mcp/auth_callback) are always allowed:
# PC_MCP_OAUTH_REDIRECT_URI='https://chatgpt.com/connector_platform_oauth_redirect'
# OAuth connections persist in $PC_MCP_STATE/oauth/{chatgpt,claude}; delete a
# directory to log that client out. false keeps them in memory only:
# PC_MCP_OAUTH_PERSIST=true
# Optional: outbound SSH and its destination DNS through SOCKS5:
# PC_MCP_SOCKS5_PROXY='socks5h://127.0.0.1:1084'
# Optional: state/cache outside projects:
# PC_MCP_STATE='/home/YOUR_LOGIN/.config/pc-mcp'


# Enable public dependency downloads only with per-job confirmation:
PC_MCP_ALLOW_NETWORK=true
# Only if your trusted reverse proxy overwrites X-Forwarded-For:
# PC_MCP_TRUSTED_PROXIES=127.0.0.1/32
