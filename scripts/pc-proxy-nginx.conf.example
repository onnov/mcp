# Include limit zones in nginx's http {} block; customize TLS/domain separately.
limit_req_zone $binary_remote_addr zone=pc_requests:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=pc_login:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=pc_connections:10m;

